# tilegen - S-expression lowering + tree tiling to Go scaffolding
BIN    := bin/tilegen
SPEC   ?= examples/shop/spec.sexp
CONFIG ?= examples/shop/config.sexp
OUT    ?= out/shop
SQLC   ?= sqlc
BUF    ?= buf

.DEFAULT_GOAL := help
.PHONY: help build install test cover golden vet fmt fmt-check check demo demo-dir demo-postgres demo-auto demo-api demo-secrets demo-outbox demo-app check-web dump tidy clean

help: ## List targets
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-14s %s\n", $$1, $$2}'

build: ## Build bin/tilegen
	go build -trimpath -o $(BIN) .

install: ## Install tilegen into GOBIN
	go install .

test: ## Run the test suite
	go test -count=1 ./...

cover: ## Test with coverage summary
	go test -coverprofile=coverage.out ./... && go tool cover -func=coverage.out | tail -1

golden: ## Rewrite golden files after an intended change to the passes
	go test -run Shop -update ./...

vet: ## go vet
	go vet ./...

fmt: ## gofmt -s -w
	gofmt -s -w .

fmt-check: ## Fail if anything is not gofmt'd
	@test -z "$$(gofmt -s -l . | tee /dev/stderr)" || (echo "run: make fmt"; exit 1)

check: fmt-check vet test ## Everything CI runs

demo: build ## Generate the example (memory storage) and prove it compiles
	$(BIN) -config $(CONFIG) -out $(OUT) -dump $(SPEC)
	cd $(OUT) && go mod tidy && go build ./... && go vet ./...
	$(BIN) check -config $(CONFIG) -out $(OUT) -allow-holes $(SPEC) # generation is idempotent

demo-dir: build ## Generate the split-file spec in examples/shopdir and prove it compiles
	$(BIN) -out out/shopdir -dump examples/shopdir
	cd out/shopdir && go mod tidy && go build ./... && go vet ./...
	$(BIN) check -out out/shopdir -allow-holes examples/shopdir

demo-auto: build ## Per-store backend selection: memory and postgres-sqlc in one project (needs sqlc)
	@command -v $(SQLC) >/dev/null || { echo "sqlc not found: brew install sqlc"; exit 1; }
	$(BIN) explain examples/auto
	$(BIN) explain -policy examples/auto/policy.sexp examples/auto >/dev/null # the policy file parses
	$(BIN) -out out/auto -dump examples/auto
	cd out/auto && $(SQLC) generate && go mod tidy && go build ./... && go vet ./...
	$(BIN) check -out out/auto -allow-holes examples/auto

demo-postgres: build ## Postgres variant: sqlc generate, then build and vet (needs sqlc)
	@command -v $(SQLC) >/dev/null || { echo "sqlc not found: brew install sqlc, or see https://docs.sqlc.dev/en/latest/overview/install.html"; exit 1; }
	$(BIN) -config examples/shop/config.postgres.sexp -out out/shop-pg -dump $(SPEC)
	cd out/shop-pg && $(SQLC) generate && go mod tidy && go build ./... && go vet ./...
	$(BIN) check -config examples/shop/config.postgres.sexp -out out/shop-pg -allow-holes $(SPEC)
	@! grep -rl "Code generated by tilegen" out/shop-pg/internal/db || (echo "tilegen marker leaked into sqlc output"; exit 1)

demo-outbox: build ## Outbox: an entity and its events in one transaction; sqlc generate, then build and vet (needs sqlc)
	@command -v $(SQLC) >/dev/null || { echo "sqlc not found: brew install sqlc, or see https://docs.sqlc.dev/en/latest/overview/install.html"; exit 1; }
	$(BIN) explain examples/outbox/spec.sexp
	$(BIN) -out out/outbox examples/outbox/spec.sexp
	cd out/outbox && $(SQLC) generate && go mod tidy && go build ./... && go vet ./...
	$(BIN) check -out out/outbox -allow-holes examples/outbox/spec.sexp

demo-api: build ## API variant: a .proto and a server for Connect, then for gRPC (needs buf and the protoc-gen plugins)
	@for t in $(BUF) protoc-gen-go protoc-gen-connect-go protoc-gen-go-grpc; do command -v $$t >/dev/null || { echo "$$t not found: see "APIs" in README.md"; exit 1; }; done
	$(BIN) explain examples/api/spec.sexp
	$(BIN) -out out/api-connect examples/api/spec.sexp
	cd out/api-connect && $(BUF) lint && $(BUF) format -d --exit-code && $(BUF) generate && go mod tidy && go build ./... && go vet ./...
	$(BIN) check -out out/api-connect -allow-holes examples/api/spec.sexp
	$(BIN) -config examples/api/config.grpc.sexp -out out/api-grpc examples/api/spec.sexp
	cd out/api-grpc && $(BUF) lint && $(BUF) format -d --exit-code && $(BUF) generate && go mod tidy && go build ./... && go vet ./...
	$(BIN) check -config examples/api/config.grpc.sexp -out out/api-grpc -allow-holes examples/api/spec.sexp
	@! grep -rl "Code generated by tilegen" out/api-connect/gen out/api-grpc/gen || (echo "tilegen marker leaked into buf output"; exit 1)

check-web: ## The studio's requirement sheet against the real compiler, in WebAssembly (needs node)
	@command -v node >/dev/null || { echo "node not found: check-web runs the page's sheet under Node"; exit 1; }
	GOOS=js GOARCH=wasm go build -o out/tilegen.wasm .
	node web/test/sheet.js "$$(go env GOROOT)/lib/wasm/wasm_exec.js" out/tilegen.wasm

demo-app: build ## A program: wire_gen.go and main.go; it must build, vet, and refuse to start unconfigured
	$(BIN) -out out/app examples/app/spec.sexp
	cd out/app && go mod tidy && go build ./... && go vet ./...
	$(BIN) check -out out/app -allow-holes examples/app/spec.sexp
	@cd out/app && if go run ./cmd/notes 2>/tmp/tilegen-demo-app.err; then echo "the program started without its secret"; exit 1; fi; \
		grep -q "secrets not set in the environment: API_TOKEN" /tmp/tilegen-demo-app.err || { cat /tmp/tilegen-demo-app.err; exit 1; }

demo-secrets: build ## Secrets from the environment, then mounted files, then Vault: each must build and vet
	$(BIN) explain examples/secrets/spec.sexp
	$(BIN) -out out/secrets-env examples/secrets/spec.sexp
	cd out/secrets-env && go mod tidy && go build ./... && go vet ./...
	$(BIN) check -out out/secrets-env examples/secrets/spec.sexp
	$(BIN) -config examples/secrets/config.file.sexp -out out/secrets-file examples/secrets/spec.sexp
	cd out/secrets-file && go mod tidy && go build ./... && go vet ./...
	$(BIN) -config examples/secrets/config.vault.sexp -out out/secrets-vault examples/secrets/spec.sexp
	cd out/secrets-vault && go mod tidy && go build ./... && go vet ./...
	$(BIN) check -config examples/secrets/config.vault.sexp -out out/secrets-vault examples/secrets/spec.sexp

dump: build ## Print the S-expression after every pass
	@$(BIN) -config $(CONFIG) -out $(OUT) -dump $(SPEC) 2>/dev/null
	@for f in $(OUT)/.tilegen/*.sexp; do printf '\n===== %s\n' $$f; cat $$f; done

tidy: ## go mod tidy
	go mod tidy

clean: ## Remove build output and generated demos
	rm -rf bin out coverage.out
