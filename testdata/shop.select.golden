(gomod
  (module "github.com/acme/shop")
  (go "1.22")
  (require "github.com/google/uuid" "v1.6.0"))

(go/file "orders/orders_gen.go"
  (mode generated)
  (package orders)
  (doc "Package orders tracks customer orders.")
  (import uuid "github.com/google/uuid")
  (go/struct Order
    (doc "Order is a placed customer order.")
    (field ID uuid.UUID (tag "json:\"id\""))
    (field CustomerEmail string (tag "json:\"customer_email\""))
    (field TotalCents int64
      (doc "Total in minor currency units.")
      (tag "json:\"total_cents\""))
    (field PlacedAt time.Time (tag "json:\"placed_at\""))
    (field ShippedAt *time.Time (tag "json:\"shipped_at\"")))
  (go/interface OrderStore
    (doc "OrderStore persists Order values.")
    (method Get
      (doc "Get returns the Order with the given ID.")
      (params (ctx context.Context) (id uuid.UUID))
      (returns *Order error))
    (method List
      (doc "List returns all Order values ordered by ID.")
      (params (ctx context.Context))
      (returns []*Order error))
    (method Save
      (doc "Save inserts or replaces order by ID.")
      (params (ctx context.Context) (order *Order))
      (returns error))
    (method Delete
      (doc "Delete removes the Order with the given ID.")
      (params (ctx context.Context) (id uuid.UUID))
      (returns error)))
  (go/assert OrderStore MemoryOrderStore)
  (go/var ErrNotFound "errors.New(\"orders: not found\")"
    (doc "ErrNotFound is returned when a requested value does not exist."))
  (go/interface Pricer
    (doc "Pricer computes order totals.")
    (method Quote
      (doc "Quote returns the total for o in minor units.")
      (params (ctx context.Context) (o *Order))
      (returns int64 error))))

(go/file "orders/memory_order_store.go"
  (mode keep)
  (package orders)
  (import uuid "github.com/google/uuid")
  (go/struct MemoryOrderStore
    (doc "MemoryOrderStore implements OrderStore using memory storage.")
    (field mu sync.Mutex)
    (field m "map[uuid.UUID]*Order"))
  (go/func NewMemoryOrderStore
    (doc "NewMemoryOrderStore returns a ready-to-use MemoryOrderStore.")
    (params)
    (returns *MemoryOrderStore)
    (body "return &MemoryOrderStore{m: make(map[uuid.UUID]*Order)}"))
  (go/func Get
    (recv s *MemoryOrderStore)
    (params (ctx context.Context) (id uuid.UUID))
    (returns *Order error)
    (body "panic(\"tilegen:hole orders.MemoryOrderStore.Get\")"))
  (go/func List
    (recv s *MemoryOrderStore)
    (params (ctx context.Context))
    (returns []*Order error)
    (body "panic(\"tilegen:hole orders.MemoryOrderStore.List\")"))
  (go/func Save
    (recv s *MemoryOrderStore)
    (params (ctx context.Context) (order *Order))
    (returns error)
    (body "panic(\"tilegen:hole orders.MemoryOrderStore.Save\")"))
  (go/func Delete
    (recv s *MemoryOrderStore)
    (params (ctx context.Context) (id uuid.UUID))
    (returns error)
    (body "panic(\"tilegen:hole orders.MemoryOrderStore.Delete\")")))

(llm/task
  (id "orders.MemoryOrderStore.Get")
  (file "orders/memory_order_store.go")
  (symbol "(*MemoryOrderStore).Get")
  (contract "Get(ctx context.Context, id uuid.UUID) (*Order, error)")
  (intent "Look up id in s.m while holding s.mu. Return ErrNotFound when absent.")
  (context-file "orders/orders_gen.go")
  (constraint "Save must be idempotent for the same ID.")
  (constraint "Never log CustomerEmail."))

(llm/task
  (id "orders.MemoryOrderStore.List")
  (file "orders/memory_order_store.go")
  (symbol "(*MemoryOrderStore).List")
  (contract "List(ctx context.Context) ([]*Order, error)")
  (intent "Collect every value in s.m while holding s.mu and sort them by ID.")
  (context-file "orders/orders_gen.go")
  (constraint "Save must be idempotent for the same ID.")
  (constraint "Never log CustomerEmail."))

(llm/task
  (id "orders.MemoryOrderStore.Save")
  (file "orders/memory_order_store.go")
  (symbol "(*MemoryOrderStore).Save")
  (contract "Save(ctx context.Context, order *Order) error")
  (intent "Store the value in s.m keyed by its ID while holding s.mu, replacing any existing one.")
  (context-file "orders/orders_gen.go")
  (constraint "Save must be idempotent for the same ID.")
  (constraint "Never log CustomerEmail."))

(llm/task
  (id "orders.MemoryOrderStore.Delete")
  (file "orders/memory_order_store.go")
  (symbol "(*MemoryOrderStore).Delete")
  (contract "Delete(ctx context.Context, id uuid.UUID) error")
  (intent "Remove id from s.m while holding s.mu. Deleting a missing ID is not an error.")
  (context-file "orders/orders_gen.go")
  (constraint "Save must be idempotent for the same ID.")
  (constraint "Never log CustomerEmail."))

(llm/task
  (id "orders.llm-1")
  (intent "Write a Pricer that applies a 10% discount to orders over 100.00.")
  (context-file "orders/orders_gen.go"))

(go/file "billing/billing_gen.go"
  (mode generated)
  (package billing)
  (doc "Package billing invoices orders.")
  (import orders "github.com/acme/shop/orders")
  (import uuid "github.com/google/uuid")
  (go/struct Invoice
    (doc "Invoice bills one order.")
    (field ID uuid.UUID (tag "json:\"id\""))
    (field OrderID uuid.UUID (tag "json:\"order_id\""))
    (field AmountCents int64 (tag "json:\"amount_cents\""))
    (field IssuedAt time.Time (tag "json:\"issued_at\"")))
  (go/interface InvoiceStore
    (doc "InvoiceStore persists Invoice values.")
    (method Get
      (doc "Get returns the Invoice with the given ID.")
      (params (ctx context.Context) (id uuid.UUID))
      (returns *Invoice error))
    (method Save
      (doc "Save inserts or replaces invoice by ID.")
      (params (ctx context.Context) (invoice *Invoice))
      (returns error)))
  (go/assert InvoiceStore MemoryInvoiceStore)
  (go/var ErrNotFound "errors.New(\"billing: not found\")"
    (doc "ErrNotFound is returned when a requested value does not exist."))
  (go/interface Invoicer
    (doc "Invoicer turns orders into invoices.")
    (method InvoiceFor
      (doc "InvoiceFor builds the invoice for o, priced by p.")
      (params (ctx context.Context) (o *orders.Order) (p orders.Pricer))
      (returns *Invoice error))))

(go/file "billing/memory_invoice_store.go"
  (mode keep)
  (package billing)
  (import uuid "github.com/google/uuid")
  (go/struct MemoryInvoiceStore
    (doc "MemoryInvoiceStore implements InvoiceStore using memory storage.")
    (field mu sync.Mutex)
    (field m "map[uuid.UUID]*Invoice"))
  (go/func NewMemoryInvoiceStore
    (doc "NewMemoryInvoiceStore returns a ready-to-use MemoryInvoiceStore.")
    (params)
    (returns *MemoryInvoiceStore)
    (body "return &MemoryInvoiceStore{m: make(map[uuid.UUID]*Invoice)}"))
  (go/func Get
    (recv s *MemoryInvoiceStore)
    (params (ctx context.Context) (id uuid.UUID))
    (returns *Invoice error)
    (body "panic(\"tilegen:hole billing.MemoryInvoiceStore.Get\")"))
  (go/func Save
    (recv s *MemoryInvoiceStore)
    (params (ctx context.Context) (invoice *Invoice))
    (returns error)
    (body "panic(\"tilegen:hole billing.MemoryInvoiceStore.Save\")")))

(llm/task
  (id "billing.MemoryInvoiceStore.Get")
  (file "billing/memory_invoice_store.go")
  (symbol "(*MemoryInvoiceStore).Get")
  (contract "Get(ctx context.Context, id uuid.UUID) (*Invoice, error)")
  (intent "Look up id in s.m while holding s.mu. Return ErrNotFound when absent.")
  (context-file "billing/billing_gen.go"))

(llm/task
  (id "billing.MemoryInvoiceStore.Save")
  (file "billing/memory_invoice_store.go")
  (symbol "(*MemoryInvoiceStore).Save")
  (contract "Save(ctx context.Context, invoice *Invoice) error")
  (intent "Store the value in s.m keyed by its ID while holding s.mu, replacing any existing one.")
  (context-file "billing/billing_gen.go"))
