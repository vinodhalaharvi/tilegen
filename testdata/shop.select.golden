(gomod
  (module "github.com/acme/shop")
  (go "1.22")
  (require "github.com/google/uuid" "v1.6.0"))

(go/file "orders/orders_gen.go"
  (mode generated)
  (package orders)
  (doc "Package orders tracks customer orders.")
  (import uuid "github.com/google/uuid")
  (go/type Status string (doc "Status is where an order is in its lifecycle."))
  (go/consts
    (const StatusPending Status "pending")
    (const StatusPaid Status "paid")
    (const StatusShipped Status "shipped")
    (const StatusCancelled Status "cancelled"))
  (go/var StatusValues "[]Status{StatusPending, StatusPaid, StatusShipped, StatusCancelled}"
    (doc "StatusValues lists every Status, in declaration order."))
  (go/func Valid
    (doc "Valid reports whether s is a known Status.")
    (recv s Status)
    (params)
    (returns bool)
    (body "switch s {\ncase StatusPending, StatusPaid, StatusShipped, StatusCancelled:\nreturn true\n}\nreturn false"))
  (go/func ParseStatus
    (doc "ParseStatus returns the Status spelled s, or an error.")
    (params (s string))
    (returns Status error)
    (body "if v := Status(s); v.Valid() {\nreturn v, nil\n}\nreturn \"\", fmt.Errorf(\"unknown Status %q\", s)"))
  (go/struct Order
    (doc "Order is a placed customer order.")
    (field ID uuid.UUID (tag "json:\"id\""))
    (field CustomerEmail string (tag "json:\"customer_email\""))
    (field TotalCents int64
      (doc "Total in minor currency units.")
      (tag "json:\"total_cents\""))
    (field PlacedAt time.Time (tag "json:\"placed_at\""))
    (field ShippedAt *time.Time (tag "json:\"shipped_at\""))
    (field Status Status (tag "json:\"status\"")))
  (go/interface OrderStore
    (doc "OrderStore persists Order values.")
    (method Get
      (doc "Get returns the Order with the given ID.")
      (params (ctx context.Context) (id uuid.UUID))
      (returns *Order error))
    (method List
      (doc "List returns all Order values ordered by ID.")
      (params (ctx context.Context))
      (returns []*Order error))
    (method Save
      (doc "Save inserts or replaces order by ID.")
      (params (ctx context.Context) (order *Order))
      (returns error))
    (method Delete
      (doc "Delete removes the Order with the given ID.")
      (params (ctx context.Context) (id uuid.UUID))
      (returns error))
    (method ListByCustomerEmail
      (doc "ListByCustomerEmail returns the Order values whose CustomerEmail equals customerEmail, ordered by ID.")
      (params (ctx context.Context) (customerEmail string))
      (returns []*Order error))
    (method Count
      (doc "Count returns how many Order values exist.")
      (params (ctx context.Context))
      (returns int64 error)))
  (go/assert OrderStore MemoryOrderStore)
  (go/var ErrNotFound "errors.New(\"orders: not found\")"
    (doc "ErrNotFound is returned when a requested value does not exist."))
  (go/interface Pricer
    (doc "Pricer computes order totals.")
    (method Quote
      (doc "Quote returns the total for o in minor units.")
      (params (ctx context.Context) (o *Order))
      (returns int64 error))))

(go/file "orders/memory_order_store.go"
  (mode keep)
  (package orders)
  (import uuid "github.com/google/uuid")
  (go/struct MemoryOrderStore
    (doc "MemoryOrderStore implements OrderStore using memory storage.")
    (field mu sync.Mutex)
    (field m "map[uuid.UUID]*Order"))
  (go/func NewMemoryOrderStore
    (doc "NewMemoryOrderStore returns a ready-to-use MemoryOrderStore.")
    (params)
    (returns *MemoryOrderStore)
    (body "return &MemoryOrderStore{m: make(map[uuid.UUID]*Order)}"))
  (go/func Get
    (recv s *MemoryOrderStore)
    (params (ctx context.Context) (id uuid.UUID))
    (returns *Order error)
    (body "panic(\"tilegen:hole orders.MemoryOrderStore.Get\")"))
  (go/func List
    (recv s *MemoryOrderStore)
    (params (ctx context.Context))
    (returns []*Order error)
    (body "panic(\"tilegen:hole orders.MemoryOrderStore.List\")"))
  (go/func Save
    (recv s *MemoryOrderStore)
    (params (ctx context.Context) (order *Order))
    (returns error)
    (body "panic(\"tilegen:hole orders.MemoryOrderStore.Save\")"))
  (go/func Delete
    (recv s *MemoryOrderStore)
    (params (ctx context.Context) (id uuid.UUID))
    (returns error)
    (body "panic(\"tilegen:hole orders.MemoryOrderStore.Delete\")"))
  (go/func ListByCustomerEmail
    (recv s *MemoryOrderStore)
    (params (ctx context.Context) (customerEmail string))
    (returns []*Order error)
    (body "panic(\"tilegen:hole orders.MemoryOrderStore.ListByCustomerEmail\")"))
  (go/func Count
    (recv s *MemoryOrderStore)
    (params (ctx context.Context))
    (returns int64 error)
    (body "panic(\"tilegen:hole orders.MemoryOrderStore.Count\")")))

(llm/task
  (id "orders.MemoryOrderStore.Get")
  (file "orders/memory_order_store.go")
  (symbol "(*MemoryOrderStore).Get")
  (contract "Get(ctx context.Context, id uuid.UUID) (*Order, error)")
  (intent "Look up id in s.m while holding s.mu. Return ErrNotFound when absent.")
  (context-file "orders/orders_gen.go")
  (constraint "Save must be idempotent for the same ID.")
  (constraint "Never log CustomerEmail."))

(llm/task
  (id "orders.MemoryOrderStore.List")
  (file "orders/memory_order_store.go")
  (symbol "(*MemoryOrderStore).List")
  (contract "List(ctx context.Context) ([]*Order, error)")
  (intent "Collect every value in s.m while holding s.mu and sort them by ID.")
  (context-file "orders/orders_gen.go")
  (constraint "Save must be idempotent for the same ID.")
  (constraint "Never log CustomerEmail."))

(llm/task
  (id "orders.MemoryOrderStore.Save")
  (file "orders/memory_order_store.go")
  (symbol "(*MemoryOrderStore).Save")
  (contract "Save(ctx context.Context, order *Order) error")
  (intent "Store the value in s.m keyed by its ID while holding s.mu, replacing any existing one.")
  (context-file "orders/orders_gen.go")
  (constraint "Save must be idempotent for the same ID.")
  (constraint "Never log CustomerEmail."))

(llm/task
  (id "orders.MemoryOrderStore.Delete")
  (file "orders/memory_order_store.go")
  (symbol "(*MemoryOrderStore).Delete")
  (contract "Delete(ctx context.Context, id uuid.UUID) error")
  (intent "Remove id from s.m while holding s.mu. Deleting a missing ID is not an error.")
  (context-file "orders/orders_gen.go")
  (constraint "Save must be idempotent for the same ID.")
  (constraint "Never log CustomerEmail."))

(llm/task
  (id "orders.MemoryOrderStore.ListByCustomerEmail")
  (file "orders/memory_order_store.go")
  (symbol "(*MemoryOrderStore).ListByCustomerEmail")
  (contract "ListByCustomerEmail(ctx context.Context, customerEmail string) ([]*Order, error)")
  (intent "Collect the values in s.m whose CustomerEmail equals customerEmail, sorted by ID, while holding s.mu.")
  (context-file "orders/orders_gen.go")
  (constraint "Save must be idempotent for the same ID.")
  (constraint "Never log CustomerEmail."))

(llm/task
  (id "orders.MemoryOrderStore.Count")
  (file "orders/memory_order_store.go")
  (symbol "(*MemoryOrderStore).Count")
  (contract "Count(ctx context.Context) (int64, error)")
  (intent "Return len(s.m) while holding s.mu.")
  (context-file "orders/orders_gen.go")
  (constraint "Save must be idempotent for the same ID.")
  (constraint "Never log CustomerEmail."))

(go/file "orders/http_gen.go"
  (mode generated)
  (package orders)
  (import uuid "github.com/google/uuid")
  (go/struct Handler
    (doc "Handler serves the orders HTTP API over its stores.")
    (field orders OrderStore))
  (go/func NewHandler
    (doc "NewHandler returns a Handler over the given stores.")
    (params (orders OrderStore))
    (returns *Handler)
    (body "return &Handler{orders: orders}"))
  (go/func Routes
    (doc "Routes returns a mux serving every route of this API.\nnet/http answers 404 for an unknown path and 405 for a known path\nwith the wrong method, so neither is handled here.")
    (recv h *Handler)
    (params)
    (returns "*http.ServeMux")
    (body "mux := http.NewServeMux()\n\tmux.HandleFunc(\"GET /orders/{id}\", h.GetOrder)\n\tmux.HandleFunc(\"GET /orders\", h.ListOrders)\n\tmux.HandleFunc(\"POST /orders\", h.SaveOrder)\nreturn mux"))
  (go/func GetOrder
    (doc "GetOrder serves GET /orders/{id}.")
    (recv h *Handler)
    (params (w "http.ResponseWriter") (r "*http.Request"))
    (returns)
    (uses uuid.UUID Order)
    (body "id, err := uuid.Parse(r.PathValue(\"id\"))\nif err != nil {\n\thttpError(w, http.StatusBadRequest, err)\n\treturn\n}\nv, err := h.orders.Get(r.Context(), id)\nif err != nil {\n\thttpError(w, h.statusForOrder(err), err)\n\treturn\n}\nwriteJSON(w, http.StatusOK, v)"))
  (go/func ListOrders
    (doc "ListOrders serves GET /orders.")
    (recv h *Handler)
    (params (w "http.ResponseWriter") (r "*http.Request"))
    (returns)
    (uses string Order)
    (body "vs, err := h.orders.List(r.Context())\nif err != nil {\n\thttpError(w, h.statusForOrder(err), err)\n\treturn\n}\nwriteJSON(w, http.StatusOK, vs)"))
  (go/func SaveOrder
    (doc "SaveOrder serves POST /orders.")
    (recv h *Handler)
    (params (w "http.ResponseWriter") (r "*http.Request"))
    (returns)
    (uses string Order)
    (body "var v Order\nif err := readJSON(r, &v); err != nil {\n\thttpError(w, http.StatusBadRequest, err)\n\treturn\n}\nif err := h.validateOrder(&v); err != nil {\n\thttpError(w, http.StatusBadRequest, err)\n\treturn\n}\nif err := h.orders.Save(r.Context(), &v); err != nil {\n\thttpError(w, h.statusForOrder(err), err)\n\treturn\n}\nwriteJSON(w, http.StatusOK, &v)"))
  (go/raw "// writeJSON sends v as JSON with the given status.\nfunc writeJSON(w http.ResponseWriter, status int, v any) {\n\tw.Header().Set(\"Content-Type\", \"application/json\")\n\tw.WriteHeader(status)\n\tif err := json.NewEncoder(w).Encode(v); err != nil {\n\t\t// The status is already written, so the client sees a truncated\n\t\t// body; there is nothing better to do than stop.\n\t\treturn\n\t}\n}\n\n// readJSON decodes a request body, rejecting unknown fields so a typo in\n// a client's payload is an error rather than a silently ignored field.\nfunc readJSON(r *http.Request, v any) error {\n\tdec := json.NewDecoder(http.MaxBytesReader(nil, r.Body, 1<<20))\n\tdec.DisallowUnknownFields()\n\treturn dec.Decode(v)\n}\n\n// httpError sends an error as JSON. The message is the error's text, so\n// statusFor... should return 500 for anything it does not recognise.\nfunc httpError(w http.ResponseWriter, status int, err error) {\n\twriteJSON(w, status, map[string]string{\"error\": err.Error()})\n}"))

(go/file "orders/http.go"
  (mode keep)
  (package orders)
  (go/func validateOrder
    (recv h *Handler)
    (params (order *Order))
    (returns error)
    (body "panic(\"tilegen:hole orders.Handler.validateOrder\")"))
  (go/func statusForOrder
    (recv h *Handler)
    (params (err error))
    (returns int)
    (body "panic(\"tilegen:hole orders.Handler.statusForOrder\")")))

(llm/task
  (id "orders.Handler.validateOrder")
  (file "orders/http.go")
  (symbol "(*Handler).validateOrder")
  (contract "validateOrder(order *Order) error")
  (intent "Report what makes this Order unacceptable, before it reaches the store. Return nil when it is fine; the error's text is sent to the client with 400.")
  (context-file "orders/orders_gen.go")
  (context-file "orders/http_gen.go"))

(llm/task
  (id "orders.Handler.statusForOrder")
  (file "orders/http.go")
  (symbol "(*Handler).statusForOrder")
  (contract "statusForOrder(err error) int")
  (intent "Map an error from OrderStore to an HTTP status: ErrNotFound to 404, a conflict to 409, anything else to 500. Do not leak internal detail to the client.")
  (context-file "orders/orders_gen.go")
  (context-file "orders/http_gen.go"))

(go/file "orders/events_gen.go"
  (mode generated)
  (package orders)
  (import uuid "github.com/google/uuid")
  (go/struct OrderPlaced
    (doc "OrderPlaced is an event of package orders.")
    (field OrderID uuid.UUID (tag "json:\"order_id\""))
    (field TotalCents int64 (tag "json:\"total_cents\"")))
  (go/struct OrderShipped
    (doc "OrderShipped is an event of package orders.")
    (field OrderID uuid.UUID (tag "json:\"order_id\"")))
  (go/interface Bus
    (doc "Bus publishes the events of package orders and delivers them to handlers.")
    (method PublishOrderPlaced
      (doc "PublishOrderPlaced delivers e to every OrderPlaced handler.")
      (params (ctx context.Context) (e OrderPlaced))
      (returns error))
    (method OnOrderPlaced
      (doc "OnOrderPlaced subscribes h to OrderPlaced and returns a func that unsubscribes it.")
      (params (h "func(context.Context, OrderPlaced) error"))
      (returns "func()"))
    (method PublishOrderShipped
      (doc "PublishOrderShipped delivers e to every OrderShipped handler.")
      (params (ctx context.Context) (e OrderShipped))
      (returns error))
    (method OnOrderShipped
      (doc "OnOrderShipped subscribes h to OrderShipped and returns a func that unsubscribes it.")
      (params (h "func(context.Context, OrderShipped) error"))
      (returns "func()")))
  (go/struct LocalBus
    (doc "LocalBus is an in-process Bus. Publish calls every handler in subscription\norder, in the publisher's goroutine, and returns their errors joined.\nHandlers may subscribe and unsubscribe at any time, even from a handler.")
    (field orderPlacedHandlers "subscribers[OrderPlaced]")
    (field orderShippedHandlers "subscribers[OrderShipped]"))
  (go/func NewLocalBus
    (doc "NewLocalBus returns an empty LocalBus.")
    (params)
    (returns *LocalBus)
    (body "return &LocalBus{}"))
  (go/func PublishOrderPlaced
    (recv b *LocalBus)
    (params (ctx context.Context) (e OrderPlaced))
    (returns error)
    (body "return b.orderPlacedHandlers.publish(ctx, e)"))
  (go/func OnOrderPlaced
    (recv b *LocalBus)
    (params (h "func(context.Context, OrderPlaced) error"))
    (returns "func()")
    (body "return b.orderPlacedHandlers.add(h)"))
  (go/func PublishOrderShipped
    (recv b *LocalBus)
    (params (ctx context.Context) (e OrderShipped))
    (returns error)
    (body "return b.orderShippedHandlers.publish(ctx, e)"))
  (go/func OnOrderShipped
    (recv b *LocalBus)
    (params (h "func(context.Context, OrderShipped) error"))
    (returns "func()")
    (body "return b.orderShippedHandlers.add(h)"))
  (go/raw "// subscribers holds the handlers of one event type, in subscription order.\ntype subscribers[E any] struct {\n\tmu   sync.RWMutex\n\tnext int\n\tlist []subscriber[E]\n}\n\ntype subscriber[E any] struct {\n\tid int\n\tfn func(context.Context, E) error\n}\n\n// add subscribes fn and returns a func that unsubscribes it.\nfunc (s *subscribers[E]) add(fn func(context.Context, E) error) func() {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\ts.next++\n\tid := s.next\n\ts.list = append(s.list, subscriber[E]{id: id, fn: fn})\n\treturn func() {\n\t\ts.mu.Lock()\n\t\tdefer s.mu.Unlock()\n\t\tfor i, x := range s.list {\n\t\t\tif x.id == id {\n\t\t\t\ts.list = append(s.list[:i:i], s.list[i+1:]...)\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n}\n\n// publish calls every handler subscribed when it starts, in order, and\n// returns their errors joined.\nfunc (s *subscribers[E]) publish(ctx context.Context, e E) error {\n\ts.mu.RLock()\n\tlist := append([]subscriber[E](nil), s.list...)\n\ts.mu.RUnlock()\n\tvar errs []error\n\tfor _, x := range list {\n\t\tif err := x.fn(ctx, e); err != nil {\n\t\t\terrs = append(errs, err)\n\t\t}\n\t}\n\treturn errors.Join(errs...)\n}")
  (go/assert Bus LocalBus))

(llm/task
  (id "orders.llm-1")
  (intent "Write a Pricer that applies a 10% discount to orders over 100.00.")
  (context-file "orders/orders_gen.go"))

(go/file "billing/billing_gen.go"
  (mode generated)
  (package billing)
  (doc "Package billing invoices orders.")
  (import orders "github.com/acme/shop/orders")
  (import uuid "github.com/google/uuid")
  (go/struct Invoice
    (doc "Invoice bills one order.")
    (field ID uuid.UUID (tag "json:\"id\""))
    (field OrderID uuid.UUID (tag "json:\"order_id\""))
    (field AmountCents int64 (tag "json:\"amount_cents\""))
    (field IssuedAt time.Time (tag "json:\"issued_at\"")))
  (go/interface InvoiceStore
    (doc "InvoiceStore persists Invoice values.")
    (method Get
      (doc "Get returns the Invoice with the given ID.")
      (params (ctx context.Context) (id uuid.UUID))
      (returns *Invoice error))
    (method Save
      (doc "Save inserts or replaces invoice by ID.")
      (params (ctx context.Context) (invoice *Invoice))
      (returns error)))
  (go/assert InvoiceStore MemoryInvoiceStore)
  (go/var ErrNotFound "errors.New(\"billing: not found\")"
    (doc "ErrNotFound is returned when a requested value does not exist."))
  (go/interface Invoicer
    (doc "Invoicer turns orders into invoices.")
    (method InvoiceFor
